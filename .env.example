# Environment — copy this to .env and fill in your values

# Database
# For local development with SQLite (zero install):
DATABASE_URL="file:./dev.db"

# For PostgreSQL in production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scorex?schema=public"

# JWT Secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-string-at-least-32-chars"

# Server
PORT=3000
NODE_ENV=development

# Cookie settings (set to "true" in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# CORS — allowed origin for production deployment
ALLOWED_ORIGIN=http://localhost:3000

# Admin seed credentials (used by server/seed.js only)
ADMIN_EMAIL=admin@scorex.local
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
