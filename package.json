{
  "name": "scorex",
  "version": "1.0.0",
  "description": "ScoreX — Full-Stack Online Examination System",
  "main": "server/index.js",
  "scripts": {
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --name init --schema=server/prisma/schema.prisma",
    "db:migrate:prod": "npx prisma migrate deploy --schema=server/prisma/schema.prisma",
    "db:seed": "node server/seed.js",
    "db:studio": "npx prisma studio --schema=server/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --force --schema=server/prisma/schema.prisma && node server/seed.js",
    "setup": "npm install && npx prisma generate --schema=server/prisma/schema.prisma && npx prisma migrate dev --name init --schema=server/prisma/schema.prisma && node server/seed.js",
    "test": "node node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
